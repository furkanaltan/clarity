# Rov.E environment template. Values marked CHANGE_ME are secrets.
# Keep production values outside Git and split them across EnvironmentFile files
# if required by the host's systemd layout.

# Core paths
CLARITY_DB_NAME=/root/clarity/clarity.db
CLARITY_REPORTS_DIR=/root/clarity/reports
CLARITY_REPORT_ARCHIVE_DAYS=60

# App API and authentication
ROVE_APP_AUTH_SECRET=CHANGE_ME
ROVE_APP_ALLOWED_ORIGIN=https://getrove.de
ROVE_APP_ALLOWED_ORIGINS=https://getrove.de,https://www.getrove.de
ROVE_APP_API_PORT=5057
ROVE_APP_AUTH_CODE_TTL_MINUTES=10
ROVE_ACCOUNT_DELETE_CODE_TTL_MINUTES=10
ROVE_APP_AUTH_SESSION_TTL_DAYS=180
ROVE_APP_SESSION_COOKIE=rove_app_session
ROVE_APP_COOKIE_SECURE=1
ROVE_LOGIN_FROM_EMAIL=info@getrove.de
ROVE_LOGIN_FROM_NAME=Rov.E
BREVO_API_KEY=CHANGE_ME
ROVE_ADMIN_USER_IDS=

# Telegram bot
TELEGRAM_TOKEN=CHANGE_ME
ADMIN_USER_IDS=
CLARITY_USER_APPROVAL=1
CLARITY_BOT_LOCK_FILE=clarity_bot.lock

# AI providers and limits
OPENAI_API_KEY=CHANGE_ME
ROVE_AI_CHAT_MODEL=gpt-4o-mini
ROVE_AI_CHAT_TIMEOUT_SECONDS=12
ROVE_AI_CHAT_MAX_INPUT_CHARS=2000
ROVE_AI_CHAT_MAX_OUTPUT_CHARS=1200
ROVE_AI_CHAT_RATE_LIMIT=20
ROVE_AI_REPORT_TEXT=1
ROVE_SCREENSHOT_MODEL=gpt-4o-mini
ROVE_SCREENSHOT_DAILY_LIMIT=10
ROVE_SCREENSHOT_MAX_BYTES=5242880
ROVE_SCREENSHOT_MAX_ROWS=20

# Market data providers
COINMARKETCAP_API_KEY=CHANGE_ME
TWELVE_DATA_API_KEY=CHANGE_ME
LEEWAY_API_TOKEN=CHANGE_ME

# Web Push
ROVE_VAPID_PUBLIC=CHANGE_ME
ROVE_VAPID_PRIVATE=CHANGE_ME
ROVE_VAPID_SUBJECT=mailto:info@getrove.de
ROVE_INTERNAL_PUSH_SECRET=CHANGE_ME
ROVE_APP_INTERNAL_PUSH_URL=http://127.0.0.1:5057/v1/internal/push

# Reports and workers
MIN_TRACKING_DAYS=14
REPORT_SEND_WINDOW_START_HOUR=8
REPORT_SEND_WINDOW_END_HOUR=14
REPORT_WORKER_BATCH_SIZE=1
REPORT_WORKER_INTERVAL_SECONDS=10
REPORT_MAX_ATTEMPTS=3
REPORT_RETRY_DELAY_MINUTES=15
REPORT_PROCESSING_TIMEOUT_MINUTES=45
REPORT_CREATION_MISFIRE_GRACE_SECONDS=21600
ROVE_REPORT_PUBLIC_DIR=/var/www/reports
ROVE_REPORT_PUBLIC_BASE_URL=https://getrove.de/reports
ROVE_REPORT_LINK_TTL_DAYS=30
ROVE_WEB_TEMPLATE_PATH=/root/clarity/report_templates/rove_web_report.html

# Retired public-state compatibility. Leave base URL empty unless explicitly needed.
ROVE_APP_STATE_PUBLIC_DIR=/root/clarity/public/app-state
ROVE_APP_STATE_PUBLIC_BASE_URL=
ROVE_APP_STATE_LINK_TTL_DAYS=30
ROVE_APP_API_BASE_URL=
