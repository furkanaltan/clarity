# Sanitized Rov.E site template derived read-only from production on 31.08.2026.
# Certificate files must be provisioned separately; never store key contents in Git.
server {
    listen 443 ssl;
    server_name getrove.de www.getrove.de;

    root /var/www/getrove;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/getrove.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/getrove.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        try_files $uri $uri/ =404;
    }

    location ^~ /app-state/ {
        return 410;
    }

    location /app-api/ {
        proxy_pass http://127.0.0.1:5057/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /reports/ {
        alias /var/www/reports/;
        autoindex off;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "private, max-age=300" always;
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    server_name getrove.de www.getrove.de;
    return 301 https://$host$request_uri;
}
