[Unit]
Description=Rov.E externally witnessed encrypted offsite recovery
Wants=network-online.target
After=network-online.target
OnFailure=rove-recovery-watch.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/rove-recovery/venv/bin/python -B /opt/rove-recovery/current/rove_recovery_operations.py run --config /etc/rove-recovery/operations.json
Environment=PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/run/rove-recovery-gpg GIT_OPTIONAL_LOCKS=0 AWS_EC2_METADATA_DISABLED=true
LoadCredential=AWS_ACCESS_KEY_ID:/etc/rove-recovery/credentials/AWS_ACCESS_KEY_ID
LoadCredential=AWS_SECRET_ACCESS_KEY:/etc/rove-recovery/credentials/AWS_SECRET_ACCESS_KEY
LoadCredential=TELEGRAM_TOKEN:/etc/rove-recovery/credentials/TELEGRAM_TOKEN
LoadCredential=BREVO_API_KEY:/etc/rove-recovery/credentials/BREVO_API_KEY
RuntimeDirectory=rove-recovery-gpg
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=45min
TimeoutStopSec=60s
KillMode=control-group
LimitCORE=0
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/clarity /root/rove-recovery-control /root/rove-recovery-sets /root/rove-recovery-encrypted /etc/rove-recovery /opt/rove-recovery
ReadWritePaths=/var/lib/rove-recovery /run/rove-recovery-gpg
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
