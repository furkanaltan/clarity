[Unit]
Description=Rov.E App API
After=network.target

[Service]
User=root
WorkingDirectory=/root/clarity
EnvironmentFile=/root/clarity/.env
EnvironmentFile=/root/clarity/.rove-app-api.env
EnvironmentFile=-/root/clarity/.rove-leeway.env
EnvironmentFile=-/root/clarity/.rove-market-data.env
ExecStart=/root/rove-app-api-venv/bin/python -m gunicorn --config /root/clarity/deploy/gunicorn.conf.py rove_app_wsgi:app
Restart=always
RestartSec=5
RuntimeDirectory=rove-app-api
RuntimeDirectoryMode=0700
KillMode=mixed
TimeoutStopSec=105
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
